{
  "name": "pi-workspace-suite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private Pi suite for Workspace, Tasks, Ask, and embeddable frames",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drawde-nadroj/pi-workspace.git"
  },
  "workspaces": ["packages/pi-frame", "packages/pi-ask", "packages/pi-agent-contracts"],
  "files": [
    "extensions/pi-workspace/*.ts",
    "extensions/pi-workspace/assets/sounds/*",
    "extensions/pi-tasks/*.ts",
    "lib/*.ts",
    "packages/pi-ask/extensions/**/*.ts",
    "packages/pi-ask/README.md",
    "packages/pi-agent-contracts/README.md",
    "examples/minimal-plan-dock/index.ts",
    "examples/minimal-plan-dock/README.md",
    "docs/PRIMITIVES.md",
    "packages/pi-frame/README.md",
    "packages/pi-frame/FEATURE-GUIDE.md",
    "extensions/pi-workspace/README.md",
    "extensions/pi-workspace/FOOTER.md",
    "extensions/pi-workspace/ACTIVITY-BLOCKS.md",
    "extensions/pi-workspace/DOCK.md",
    "packages/pi-ask/CONTRIBUTING.md",
    "packages/pi-ask/LICENSE",
    "eval/harness/README.md",
    "docs/SETTINGS-REVIEW.md",
    "docs/README.md",
    "docs/INSTALL.md",
    "docs/TRY-PREVIEW.md",
    "docs/decisions/0001-one-repo-separate-owners.md",
    "extensions/pi-tasks/README.md",
    "README.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "docs/ARCHITECTURE.md",
    "docs/ACCEPTANCE.md",
    "docs/MIGRATION.md",
    "docs/SURFACE-WORKSPACE.md",
    "docs/POSITIONING.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/pi-workspace/index.ts",
      "./extensions/pi-tasks/index.ts",
      "./packages/pi-ask/extensions/questions.ts"
    ]
  },
  "dependencies": {
    "pi-agent-contracts": "0.1.0",
    "pi-embeddable-frame": "0.1.0"
  },
  "bundleDependencies": ["pi-agent-contracts", "pi-embeddable-frame"],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "26.6.4",
    "pi-vim": "0.14.2",
    "typebox": "1.3.36",
    "typescript": "7.0.2"
  },
  "scripts": {
    "test": "npm run typecheck && npm run test:frame && npm run test:ask && npm run test:workspace && npm run test:tasks && npm run test:examples && npm run test:shapes && npm run test:harness && npm run test:suite",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspace=pi-ask",
    "test:frame": "node --test packages/pi-frame/test/*.test.mjs",
    "test:ask": "node --test packages/pi-ask/test/host.test.mjs",
    "test:workspace": "node --test extensions/pi-workspace/tests/*.test.mjs",
    "test:tasks": "node --test extensions/pi-tasks/tests/*.test.mjs",
    "test:examples": "node --test examples/minimal-plan-dock/test.mjs",
    "test:shapes": "node --test tests/host-shapes.test.mjs",
    "test:suite": "node --test tests/suite-package.test.mjs",
    "test:harness": "node --test eval/harness/*.test.mjs",
    "eval:harness": "node eval/harness/cli.mjs",
    "pack:check": "npm pack --dry-run --workspace=pi-embeddable-frame && npm pack --dry-run --workspace=pi-ask && npm pack --dry-run"
  }
}
